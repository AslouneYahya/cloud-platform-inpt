[Unit]
Description=INPT Cloud Platform — Peer Node Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/cloud-platform-inpt/cluster-node
ExecStart=/home/pi/cloud-platform-inpt/cluster-node/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/inpt-node

[Install]
WantedBy=multi-user.target
